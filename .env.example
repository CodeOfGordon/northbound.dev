# Copy to .env.local and fill in. .env.local is gitignored; this template is committed.

# ─────────────────────────────────────────────────────────────
# App runtime (read by Next.js / Mongoose)
# ─────────────────────────────────────────────────────────────

# MongoDB connection string — database/mongodb.ts reads process.env.MONGODB_URI
# NOTE: no database path — Mongoose then uses the default db `test`, which is
# where the live data actually lives. Do NOT append /events_site.
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/

# Secret guarding POST /api/refresh and /api/digest (the cron triggers). Use a long random string.
CRON_SECRET=

# Email digest (lib/notify): recipients live in the `subscribers` collection
# (people sign up at /subscribe) — there is no recipient env var. Delivery runs
# in the GitHub Actions runner over Gmail SMTP because Vercel blocks outbound
# SMTP (ADR-025/026). Set these as REPO SECRETS, not here:
#   GMAIL_USER           — the sending Gmail address
#   GMAIL_APP_PASSWORD   — Google App Password (requires 2FA on that account)
# To test a send locally: export those two plus SITE_URL, then
#   node scripts/send-digest.mjs --dry-run   (compose only; drop the flag to send)

# Public base URL of the deployment — canonical links in metadata + digest emails.
NEXT_PUBLIC_SITE_URL=https://northbound.vercel.app

# PostHog (client-side analytics) — already wired in instrumentation-client.ts
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.posthog.com

# ─────────────────────────────────────────────────────────────
# MCP servers (read by .mcp.json — dev/agent tooling, NOT the app)
# ─────────────────────────────────────────────────────────────

# mongodb MCP — same connection string as MONGODB_URI
MDB_MCP_CONNECTION_STRING=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/events_site

# apify MCP — console.apify.com → Settings → API & Integrations
APIFY_TOKEN=

# brave-search MCP — api-dashboard.search.brave.com/app/keys (free tier ~2k queries/mo)
BRAVE_API_KEY=

# Per-source scrape cap (Apify actors are pay-per-result; keep modest). Default: 50
SCRAPE_MAX_ITEMS=50
